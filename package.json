{
  "name": "japan-local-service",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @local/web-client dev",
    "dev:merchant": "pnpm --filter @local/merchant-admin dev",
    "dev:admin": "pnpm --filter @local/platform-admin dev",
    "dev:api": "pnpm --filter @local/api dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @local/web-client build && pnpm --filter @local/merchant-admin build && pnpm --filter @local/platform-admin build",
    "build:backend": "pnpm --filter @local/api build",
    "start:prod": "pnpm --filter @local/api start:prod",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @local/api prisma:generate",
    "db:migrate": "pnpm --filter @local/api prisma:migrate",
    "db:seed": "pnpm --filter @local/api prisma:seed"
  }
}
