{
  "name": "japan-local-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:web": "npm run dev --workspace=@local/web-client",
    "dev:merchant": "npm run dev --workspace=@local/merchant-admin",
    "dev:admin": "npm run dev --workspace=@local/platform-admin",
    "dev:api": "npm run dev --workspace=@local/api",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@local/web-client && npm run build --workspace=@local/merchant-admin && npm run build --workspace=@local/platform-admin",
    "build:frontend:bundle": "node scripts/build-frontend-bundle.mjs",
    "build:backend": "npm run build --workspace=@local/api",
    "start:prod": "npm run start:prod --workspace=@local/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@local/api",
    "db:migrate": "npm run prisma:migrate --workspace=@local/api",
    "db:seed": "npm run prisma:seed --workspace=@local/api"
  }
}
