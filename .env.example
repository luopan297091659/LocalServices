NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://localservice:localservice@localhost:5432/localservice?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=local-services
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/local-services
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1
VITE_API_URL=http://localhost:3001/api/v1
UPLOAD_DIR=uploads
SWAGGER_ENABLED=true
TRUST_PROXY=false
SEED_DEMO_DATA=true

