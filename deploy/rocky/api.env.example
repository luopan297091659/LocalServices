NODE_ENV=production
SERVER_NAME=services.example.jp
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://machi_service:CHANGE_DATABASE_PASSWORD@127.0.0.1:5432/machi_service?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=CHANGE_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_TO_A_DIFFERENT_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
APP_URL=https://services.example.jp
UPLOAD_DIR=/var/lib/machi-service/uploads
SWAGGER_ENABLED=false
TRUST_PROXY=loopback
SEED_DEMO_DATA=false
